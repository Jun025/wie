# wie_validate --keys: LGT acc4215b7ec0 — title → main menu → 도움말/기타 → 게임설명.
# Grammar: `--keys` help / `parse_keys` in wie_cli/src/bin/wie_validate.rs.
#
#   mkdir -p <dir>   # --shotdir does not create it
#   cargo run -q --release -p wie_cli --bin wie_validate -- --inject \
#     --max-ticks 100000000000 --keys docs/keys/lgt-acc4215b7ec0-help.keys --shotdir <dir> <game>
#
# Step 6 (`06_OK`) opens 게임설명, whose text carries `|0xFFAE08|` colour fields parsed with
# stdlib import 0x3ff (strtol). Before docs/report/0406 that step died on
# `Unknown lgt stdlib import: 0x3ff`. One UP wraps 연습모드 → 도움말/기타. Both the 15 s settle
# and the 0.5 s holds are load-bearing: with an 8 s gap and the default 0.15 s hold the UP was
# dropped in some runs and not others (docs/report/0406 §2). Key names only — no game bytes.
#
# Deterministic ONLY on a quiet host (host-load-guard rc=0 · measured load ≈24). Under load
# (measured 125~300) step 06 never reaches 게임설명 and the run PASSes both before and after the
# fix — the schedule is wall-clock (wie_validate.rs 「The injection SCHEDULE is wall-clock」).
# Do not judge by PASS alone: confirm `strtol(` lines > 0 under
# RUST_LOG=wie_lgt::runtime::stdlib=debug, or that <dir>/*06_OK.png shows 게임설명.
WAIT:10
OK:5:0.5     # PRESS ANY KEY
OK:15:0.5    # main menu slides in — let it finish
UP:4:0.5     # wraps to 도움말/기타
OK:6:0.5     # its submenu, cursor on 게임설명
OK:4:0.5     # 게임설명 — the strtol call site
OK:4:0.5
WAIT:4
